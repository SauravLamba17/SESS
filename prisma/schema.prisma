// SESS — Simplen Employee Self-Service
// Production / Quality / Attendance / Payroll HRMS
// Prisma schema — Phase 0 Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  HR
  SUPER_ADMIN
}

enum AttendanceChannel {
  WEB
  MOBILE
  BIOMETRIC
}

enum WarningStatus {
  DRAFT
  RELEASED
}

enum PayrollStatus {
  DRAFT
  SUBMITTED
  FINALIZED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseCategory {
  TRAVEL
  FOOD
  ACCOMMODATION
  COMMUNICATION
  MISCELLANEOUS
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

model User {
  id         String    @id @default(cuid())
  clerkId    String    @unique
  role       Role
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @unique
  createdAt  DateTime  @default(now())
}

model Employee {
  id          String    @id @default(cuid())
  employeeCode String   @unique
  name        String
  department  String
  designation String?
  emergencyContact String? // Phase 1: editable on the My Profile page
  shiftId     String? // Phase 6: assigned shift (drives lateFlag)
  shift       Shift?  @relation(fields: [shiftId], references: [id])
  managerId   String?
  manager     Employee? @relation("ManagerToReports", fields: [managerId], references: [id])
  reports     Employee[] @relation("ManagerToReports")
  // A free-text workstation/bench label, NOT a link to machine-performance
  // tracking (that feature and its MachineLog model were cut — see below).
  // Retained because it is part of the bulk-import CSV contract HR already uses.
  machineId   String?
  joiningDate DateTime
  active      Boolean   @default(true)
  // Phase 7: the last working day, set when HR offboards. Pro-ration needs a
  // DATE, not just active=false — an employee who left on the 12th is owed 12
  // days, and `active` alone cannot express that.
  offboardedAt DateTime?
  // Phase 13 retention policy: 5 years after the last working day, this
  // employee's DIRECT PERSONAL IDENTIFIERS become due for redaction. Set when
  // they are offboarded. It is NOT a deletion date — the Employee row and every
  // financial/business record attached to it are kept permanently, because the
  // statutory reason for the 5-year window is precisely that payroll must
  // remain auditable. See app/hr/employees/retention-review.
  scheduledRedactionAt DateTime?
  /** Set once personal identifiers have actually been redacted. */
  redactedAt  DateTime?
  pfUan       String? // Provident Fund UAN — nullable, not every employee has one yet
  // Invitation phase: how a Clerk signup is correlated back to this Employee.
  // Stored lowercased; the webhook matches user.created emails against it.
  // Nullable — historical/bulk-imported employees may never get login access.
  email       String?   @unique
  // Clerk invitation id while "sent, awaiting acceptance"; cleared on link.
  pendingInvitationId String?
  // Phase 9: used ONLY to surface a name on the birthday widget. Nullable —
  // existing employees have none until HR backfills. Never displayed as a
  // full date, and never used to compute or show an age.
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())

  // Back-relations
  user           User?
  attendance     Attendance[]
  production     Production[]
  qualityReports QualityReport[]
  idleLogs       IdleLog[]
  clientMails    ClientMail[]
  warningLetters WarningLetter[]
  appraisalScores AppraisalScore[]
  payrolls       Payroll[]
  consentRecords ConsentRecord[]
  leaveRequests  LeaveRequest[]
  monthlyTargets MonthlyTarget[]
  salaryStructure SalaryStructure?
  salaryHistory   SalaryStructureHistory[]
  expenseClaims  ExpenseClaim[]
  salaryAdvances SalaryAdvance[]
  notifications  Notification[]
  onboardingTasks OnboardingTask[]
  shoutOutsSent     ShoutOut[] @relation("ShoutOutFrom")
  shoutOutsReceived ShoutOut[] @relation("ShoutOutTo")
  agentToken        AgentToken?
}

// Phase 6: named shifts replace the single global WORKDAY_START env var.
model Shift {
  id                 String     @id @default(cuid())
  name               String     @unique
  startTime          String // "HH:MM", e.g. "09:30"
  endTime            String // "HH:MM", e.g. "18:00"
  gracePeriodMinutes Int        @default(0) // minutes after startTime before lateFlag triggers
  createdBy          String
  active             Boolean    @default(true)
  employees          Employee[]
}

model Attendance {
  id             String            @id @default(cuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  channel        AttendanceChannel @default(WEB)
  ipAddress      String?
  lat            Float?
  long           Float?
  /// Radius of the browser's own confidence circle for lat/long, in metres
  /// (GeolocationCoordinates.accuracy). Recorded so a reviewer can tell a
  /// 20 m rooftop fix from a 2 km cell-tower one instead of treating every
  /// coordinate as equally precise. NEVER judged: no punch is blocked,
  /// flagged or scored on this value — see app/api/attendance/punch.
  /// Null whenever lat/long are null, i.e. the device declined or failed.
  accuracy       Float?
  lateFlag       Boolean           @default(false)
  lateMinutes    Int? // Phase 7: minutes past (shift.startTime + grace) if late; null if not late / no shift data
  checkInNote    String? // mandatory employee comment captured at web clock-in
  approvedBy     String?
  // Phase 1: a punch that fails IP/geofence validation is still written,
  // flagged for HR review with the specific reason(s) recorded here.
  flaggedForReview Boolean         @default(false)
  reviewReason   String?

  @@index([employeeId, date])
}

model Production {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  date          DateTime
  unitsProduced Int
  targetUnits   Int
  loggedBy      String?

  // One production row per employee per date (Phase 3 self-logging upsert key).
  @@unique([employeeId, date])
}

model QualityReport {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime
  defectCount  Int      @default(0)
  qualityScore Float
  reviewedBy   String?

  // One quality report per employee per date (Phase 3 upsert key).
  @@unique([employeeId, date])
}

// Idle/active tracking. ONLY these two totals per employee per day — there is
// no per-event, per-application or per-window data anywhere in this model, by
// design. See lib/idle/README-scope.md for the full constraint.
model IdleLog {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  date          DateTime
  idleMinutes   Int      @default(0)
  activeMinutes Int      @default(0)

  // REQUIRED for the heartbeat's atomic upsert: Prisma needs a unique target
  // to upsert against, and this composite is what makes
  // `update: { idleMinutes: { increment } }` compile to a single
  // `UPDATE ... SET col = col + n` rather than a read-then-write.
  @@unique([employeeId, date])
  @@index([employeeId, date])
}

// Authenticates the desktop agent. Deliberately NOT a Clerk session: the agent
// is a background service on a machine, with no browser and no interactive
// login. One token per employee (@unique) — reissuing replaces the old one,
// so a decommissioned machine's token stops working the moment a new one is
// generated.
model AgentToken {
  id         String    @id @default(cuid())
  employeeId String    @unique
  employee   Employee  @relation(fields: [employeeId], references: [id])
  token      String    @unique // long random secret, generated server-side
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  // Bumped on every accepted heartbeat, so HR can spot an agent that has gone
  // silent (machine off, uninstalled, network blocked) without guessing.
  lastSeenAt DateTime?

  @@index([active])
}

// Small key/value store for values a Super Admin must be able to change
// without a redeploy. The existing env-var convention (ATTENDANCE_VALIDATION_MODE)
// is fine for deploy-time config, but the idle threshold needs to be
// adjustable from the UI, and an env var cannot be.
model SystemSetting {
  key       String   @id
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
}

// One row per accepted attempt against a rate-limited action.
//
// WHY A TABLE AND NOT A Map: the public careers form runs on serverless, where
// every request may land on a different short-lived instance. A per-process
// Map therefore counts a fraction of the real traffic and resets constantly —
// it does not rate-limit anything in that environment. Postgres is the only
// state all instances already share, so the counter lives here.
//
// Rows are disposable: they exist only to be counted inside a rolling window
// and are swept opportunistically once past RETENTION (see
// lib/recruitment/rate-limit.ts). Nothing joins to this table and nothing reads
// an individual row, so it carries no foreign keys and no relations.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  /// The bucket — currently the requesting IP.
  key       String
  /// Which limit this counts against, so the table can serve more than one.
  action    String
  createdAt DateTime @default(now())

  // Serves both the windowed COUNT (key+action+createdAt) and, by prefix, the
  // retention sweep's range scan on createdAt.
  @@index([key, action, createdAt])
}

model ClientMail {
  id                String   @id @default(cuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id])
  subject           String
  summary           String? // manager-typed text. Renamed from summaryViaClaude: this system never uses an LLM, and the old name implied otherwise.
  taggedByManagerId String?
  date              DateTime
}

model WarningLetter {
  id           String        @id @default(cuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id])
  issuedBy     String
  reason       String
  fileUrl      String?
  status       WarningStatus @default(DRAFT)
  releasedBy   String?
  releasedAt   DateTime?
  // Retained for backward compatibility with Phase 2's simple flow. Still set,
  // alongside the richer attestation fields below.
  acknowledged Boolean       @default(false)

  // ── Attestation Record (NOT a legal digital signature) ────────────
  // The employee types their own name to acknowledge. Stronger than a bare
  // checkbox because it records WHAT was typed, WHEN, and FROM WHERE — but it
  // is an internal record only. A legally-binding signature under India's IT
  // Act requires a licensed Certifying Authority / eSign provider, which this
  // deliberately is not and must never be presented as.
  attestedName String?
  attestedAt   DateTime?
  attestedIp   String?

  createdAt    DateTime      @default(now())
}

model AppraisalCycle {
  id          String           @id @default(cuid())
  period      String // e.g. "2026-Q3"
  department  String?
  weightsJson Json // { punctuality, production, quality, feedback, warningPenalty }
  createdBy   String
  published   Boolean          @default(false)
  scores      AppraisalScore[]
  createdAt   DateTime         @default(now())
}

model AppraisalScore {
  id                  String         @id @default(cuid())
  employeeId          String
  employee            Employee       @relation(fields: [employeeId], references: [id])
  cycleId             String
  cycle               AppraisalCycle @relation(fields: [cycleId], references: [id])
  // Nullable: a row can exist pre-compute (manager feedback entered) or as an
  // INCOMPLETE row (missing component data) — final score only lands once the
  // three hard components have data. See lib/appraisal/compute.ts.
  componentScoresJson Json?
  finalScore          Float?
  managerFeedback     String? // free-text comment (Phase 0 field, retained)
  managerFeedbackScore Float? // 0-100 numeric feedback component (Phase 4)
  componentDataJson   Json? // which components had real data vs were missing
  excluded            Boolean        @default(false) // HR-excluded from this cycle

  // One score row per employee per cycle (upsert key for feedback + compute).
  @@unique([employeeId, cycleId])
}

model AppraisalFormula {
  id          String   @id @default(cuid())
  department  String? // null = global default, used when no dept-specific formula exists
  weightsJson Json // { punctuality, production, quality, feedback, warningPenaltyPoints }
  updatedBy   String // Super Admin's user id
  updatedAt   DateTime @updatedAt

  @@unique([department])
}

// Phase 13: `model MachineLog` was REMOVED here. It backed machine-performance
// tracking, which was permanently cut from scope (there is no physical
// production equipment to measure). The live table held ZERO rows and no
// employee had a machineId set, verified before dropping it, so nothing was
// lost. Employee.machineId survives as a plain workstation label — see the
// comment on that field.

// Phase 7. Every currency field is Decimal(12,2) (Postgres numeric), NEVER
// Float — a payslip and a Form 16 are legal/financial documents and binary
// floating point accumulates rounding error across the deduction chain.
model Payroll {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id])
  month       String // e.g. "2026-07"

  // Earnings — snapshotted from the employee's SalaryStructure at run creation
  // so a later structure change never rewrites history on a finalized payslip.
  // Earnings, ALREADY PRO-RATED for daysWorked (see lib/payroll/proration.ts).
  basic            Decimal @default(0) @db.Decimal(12, 2)
  hra              Decimal @default(0) @db.Decimal(12, 2)
  specialAllowance Decimal @default(0) @db.Decimal(12, 2)
  bonus            Decimal @default(0) @db.Decimal(12, 2)

  // Pro-ration inputs, stored so a payslip can always explain its own figures.
  daysWorked  Int @default(0)
  daysInMonth Int @default(0)

  // Statutory deductions — all HR-entered.
  pfEmployee      Decimal @default(0) @db.Decimal(12, 2)
  pfEmployer      Decimal @default(0) @db.Decimal(12, 2) // employer's own contribution: recorded, NOT deducted from net
  esi             Decimal @default(0) @db.Decimal(12, 2)
  professionalTax Decimal @default(0) @db.Decimal(12, 2)
  // TDS is entered by HR from the company's CA/accountant. This application
  // performs NO tax-slab, exemption or TDS computation of any kind, by design.
  tds             Decimal @default(0) @db.Decimal(12, 2)
  tdsSource       String  @default("") // provenance of the TDS figure, e.g. "CA-provided, FY2026-27"

  // Recovery of an outstanding SalaryAdvance. On a normal run this is one
  // installment; on a final settlement it is the entire remaining balance.
  loanDeduction Decimal @default(0) @db.Decimal(12, 2)

  // Approved expense claims folded into this run. Kept OUT of gross: a
  // reimbursement is not taxable salary, it is added after deductions.
  reimbursements Decimal @default(0) @db.Decimal(12, 2)

  gross      Decimal @default(0) @db.Decimal(12, 2) // basic + hra + specialAllowance (pro-rated)
  deductions Decimal @default(0) @db.Decimal(12, 2) // pfEmployee + esi + professionalTax + tds + loanDeduction
  net        Decimal @default(0) @db.Decimal(12, 2) // gross - deductions + bonus + reimbursements

  status      PayrollStatus @default(DRAFT)
  processedBy String? // HR user id
  finalizedBy String? // Super Admin user id — set only on FINALIZED
  finalizedAt DateTime?

  // Full & Final settlement row, created by the Phase 5 offboarding flow.
  isFinalSettlement Boolean @default(false)

  // Post-finalization corrections are NEW rows pointing at the original —
  // a FINALIZED row is never edited, so the trail stays auditable.
  adjustmentForPayrollId String?
  adjustmentFor          Payroll?  @relation("PayrollAdjustment", fields: [adjustmentForPayrollId], references: [id])
  adjustments            Payroll[] @relation("PayrollAdjustment")

  expenseClaims ExpenseClaim[]

  // NOT plainly unique on [employeeId, month]: a final-settlement row and an
  // adjustment row both legitimately share an employee's month with the
  // regular run.
  //
  // Duplicate REGULAR runs are blocked by a PARTIAL unique index that Prisma's
  // DSL cannot express, so it lives in raw SQL:
  //   prisma/migrations/20260727120000_payroll_unique_regular_run
  //   UNIQUE (employeeId, month) WHERE adjustmentForPayrollId IS NULL
  //                                AND isFinalSettlement = false
  // Do not assume this file shows every constraint on this table — that index
  // is the real guarantee, and app/api/hr/payroll/run/route.ts translates its
  // P2002 into a 409. The pre-flight check in that route is now an optimisation
  // and a friendlier error, not the protection itself.
  @@index([employeeId, month])
  @@index([status, month])
}

// Phase 7: the employee's CURRENT salary breakup. One row per employee.
//
// Phase 13 added history WITHOUT changing this model's shape. It stays 1:1 on
// employeeId because eight call sites depend on that relation — payroll run,
// offboarding's full & final settlement, hire-conversion, the payroll and
// salary-structure pages. Turning it into a multi-row versioned table would
// have rewritten how PAYROLL resolves an employee's pay, which is the last
// thing in this system worth destabilising for a reporting feature.
//
// Instead, every superseded version is copied into SalaryStructureHistory
// below at the moment it is replaced. "Current" stays a single indexed row;
// the full timeline is current + history. See lib/payroll/salary-history.ts.
model SalaryStructure {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  employee         Employee @relation(fields: [employeeId], references: [id])
  basic            Decimal  @db.Decimal(12, 2)
  hra              Decimal  @db.Decimal(12, 2)
  specialAllowance Decimal  @db.Decimal(12, 2)
  effectiveFrom    DateTime
  setBy            String // HR user id
  updatedAt        DateTime @updatedAt
}

// Phase 13: every SUPERSEDED salary structure, so a raise leaves a trail.
//
// Only closed versions live here — the row currently in force is the
// SalaryStructure above. A version is copied in at the instant it is replaced,
// with effectiveTo set to the incoming version's effectiveFrom, so ranges are
// half-open [effectiveFrom, effectiveTo) and can never overlap or gap.
//
// Nothing in payroll reads this table. It exists to answer "what was this
// person paid in March", not to compute anything.
model SalaryStructureHistory {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  basic            Decimal  @db.Decimal(12, 2)
  hra              Decimal  @db.Decimal(12, 2)
  specialAllowance Decimal  @db.Decimal(12, 2)
  effectiveFrom    DateTime
  /// EXCLUSIVE upper bound: the effectiveFrom of the version that replaced this.
  effectiveTo      DateTime
  /// 1 for the first structure ever set, incrementing per replacement.
  versionNumber    Int
  /// Who set THIS version originally (carried over from the structure row).
  setBy            String
  /// Who replaced it, and when — the audit pair for the change itself.
  supersededBy     String
  supersededAt     DateTime @default(now())

  @@index([employeeId, effectiveFrom])
}

model ExpenseClaim {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id])
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  description String
  receiptUrl  String?
  status      ExpenseStatus   @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  // Set once folded into a payroll run — the guard against double-reimbursement.
  includedInPayrollId String?
  includedInPayroll   Payroll? @relation(fields: [includedInPayrollId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([employeeId, status])
}

// Phase 7: an advance/loan paid to an employee, recovered via monthly
// installments on payroll. Recovery is applied at FINALIZE, never at draft
// creation — an unfinalized run must not move a real balance.
model SalaryAdvance {
  id               String     @id @default(cuid())
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id])
  principalAmount  Decimal    @db.Decimal(12, 2)
  monthlyDeduction Decimal    @db.Decimal(12, 2)
  remainingBalance Decimal    @db.Decimal(12, 2)
  status           LoanStatus @default(ACTIVE)
  issuedBy         String
  issuedAt         DateTime   @default(now())

  @@index([employeeId, status])
}

model Notification {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String // e.g. "PAYSLIP_READY"
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId, read])
}

// Append-only. Nothing in this codebase updates or deletes an AuditLog row,
// and the viewer (app/admin/audit-log) is strictly read-only.
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  action       String
  targetEntity String
  timestamp    DateTime @default(now())

  // The viewer always sorts by timestamp DESC and pages server-side, so this
  // index carries every query it makes. The two composites match the filtered
  // cases: filtering by action or actor still sorts by timestamp, and a
  // composite lets Postgres satisfy filter+sort from one index rather than
  // sorting a filtered heap.
  @@index([timestamp])
  @@index([action, timestamp])
  @@index([actorUserId, timestamp])
}

model ConsentRecord {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  // Phase 11: "FACE_VERIFICATION" was removed along with the feature (cut from
  // scope; zero rows ever recorded it). Only "IDLE_TRACKING" is valid now —
  // enforced in app/api/hr/consent/route.ts.
  consentType     String // "IDLE_TRACKING"
  givenOn         DateTime
  retentionExpiry DateTime?
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  createdAt  DateTime    @default(now())

  @@index([employeeId, status])
}

// Phase 2: manager-set monthly targets. Kept separate from Production so a
// manager's target write and an employee's daily actual write never collide
// on the same row. The @@unique makes target-setting a clean upsert.
model MonthlyTarget {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  period      String // "YYYY-MM", e.g. "2026-07"
  targetUnits Int
  setBy       String // manager's user id
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, period])
}

// ─────────────────────────────────────────────────────────────
// Phase 8 — Recruitment / ATS
//
// Every decision in this subsystem is a HUMAN action on plain data:
// stage transitions, offer approval and hiring are all explicit clicks by a
// named user, recorded in AuditLog. Resumes are stored and read by people —
// there is no parsing, extraction, scoring or summarisation anywhere, and
// none is to be added. This is a permanent design constraint for the whole
// system, not a limitation of this phase.
// ─────────────────────────────────────────────────────────────

enum RequisitionStatus {
  OPEN
  ON_HOLD
  CLOSED
}

model JobRequisition {
  id           String            @id @default(cuid())
  title        String
  department   String
  description  String
  openings     Int
  status       RequisitionStatus @default(OPEN)
  createdBy    String
  createdAt    DateTime          @default(now())
  closedAt     DateTime?
  applications Application[]

  @@index([status])
}

model Candidate {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String
  // Storage KEY, not a public URL. Resumes live outside the web root and are
  // served only through the role-checked /api/resume/[applicationId] route —
  // putting them in public/ would expose every applicant's CV to the internet.
  resumeUrl    String
  source       String // e.g. "Career Page", "Referral"
  createdAt    DateTime      @default(now())

  // ── Data retention (DPDP-oriented) ────────────────────────────────
  // Real opt-in: the career-page checkbox is unchecked by default and this
  // stays false unless the applicant actively ticks it.
  talentPoolConsent   Boolean   @default(false)
  talentPoolConsentAt DateTime?
  // When this candidate's personal data becomes due for review and deletion.
  // Set on rejection: +1 year without consent, +2 years with it. Even the
  // consented window is bounded — "indefinite" is the problem being fixed.
  // Nothing deletes automatically; HR reviews and acts (see
  // app/hr/candidates/retention-review).
  scheduledDeletionAt DateTime?

  applications Application[]

  @@index([email])
  @@index([scheduledDeletionAt])
}

enum PipelineStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Application {
  id               String         @id @default(cuid())
  candidateId      String
  candidate        Candidate      @relation(fields: [candidateId], references: [id])
  jobRequisitionId String
  jobRequisition   JobRequisition @relation(fields: [jobRequisitionId], references: [id])
  stage            PipelineStage  @default(APPLIED)
  rejectedReason   String?
  // Free-text, human-authored review notes. Never machine-generated.
  reviewNotes      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // ── Terms & Conditions acceptance ─────────────────────────────────
  // Recorded PER APPLICATION, not per candidate, and deliberately so: a
  // repeat applicant reuses one Candidate row across several Applications,
  // so storing this on Candidate would let a later submission overwrite the
  // record of what an earlier one actually agreed to. This is a point-in-time
  // legal act, unlike Candidate.talentPoolConsent which is a standing
  // preference and correctly lives on the candidate.
  //
  // Nullable because every Application created BEFORE this column existed
  // genuinely has no acceptance on file. Backfilling a timestamp would be
  // inventing consent that was never given. New public submissions cannot be
  // created without it — app/api/careers/apply rejects them with a 400.
  termsAcceptedAt  DateTime?
  // Which wording they agreed to (see lib/recruitment/terms.ts TERMS_VERSION).
  // Stored as a string so a future terms update never retroactively
  // misrepresents what an older applicant signed up to.
  termsVersion     String?

  interviewFeedback InterviewFeedback[]
  offer             Offer?

  // One application per candidate per requisition.
  @@unique([candidateId, jobRequisitionId])
  @@index([stage])
}

model InterviewFeedback {
  id                String      @id @default(cuid())
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id])
  interviewerUserId String // the Manager or HR user who interviewed
  rating            Int // 1-5
  notes             String
  interviewDate     DateTime
  // Which interview round this feedback belongs to. Defaults to 1, which is
  // also correct for every row created before multi-round tracking existed —
  // those were all effectively a single round at the time.
  roundNumber       Int         @default(1)
  createdAt         DateTime    @default(now())

  @@index([applicationId])
}

enum OfferStatus {
  DRAFT
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

// Mirrors the Payroll DRAFT→SUBMITTED→FINALIZED pattern: HR drafts, a Super
// Admin approves, and once SENT the proposed figures are immutable through
// every code path (enforced in app/api/hr/offer/*, not just hidden in the UI).
model Offer {
  id                       String      @id @default(cuid())
  applicationId            String      @unique
  application              Application @relation(fields: [applicationId], references: [id])
  proposedBasic            Decimal     @db.Decimal(12, 2)
  proposedHra              Decimal     @db.Decimal(12, 2)
  proposedSpecialAllowance Decimal     @db.Decimal(12, 2)
  proposedDesignation      String
  proposedDepartment       String
  proposedManagerId        String? // which existing Employee they'd report to
  joiningDate              DateTime
  status                   OfferStatus @default(DRAFT)
  createdBy                String
  approvedBy               String?
  approvedAt               DateTime?
  sentAt                   DateTime?
  respondedAt              DateTime?

  // ── Attestation Record (NOT a legal digital signature) ────────────
  // IMPORTANT DISTINCTION from WarningLetter's attestation: a candidate has no
  // account here, so HR records the response on their behalf. `attestedName`
  // is therefore the CANDIDATE's name as HR typed it (validated against the
  // stored candidate name), and `attestedBy` is the HR user who entered it.
  // This is a record of HR's data entry, not of the candidate's own act —
  // weaker evidence than the employee case, and labelled as such in the UI.
  attestedName String?
  attestedAt   DateTime?
  attestedIp   String?
  attestedBy   String? // HR user id who recorded the response

  @@index([status])
}

model OnboardingTask {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  taskName    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([employeeId, completed])
}

// ─────────────────────────────────────────────────────────────
// Phase 9 — Engagement
//
// Deliberately standalone and lightweight. NOTHING here reads or writes
// Attendance.lateFlag, QualityReport, AppraisalScore or WarningLetter, and
// nothing here surfaces on an appraisal or manager-review screen. The single
// exception is the "who's in today" widget, which reads Attendance and
// LeaveRequest for PRESENCE only (in / on leave / not yet marked) — never
// lateness, never a time, never a performance signal.
// ─────────────────────────────────────────────────────────────

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  createdBy String
  createdAt DateTime @default(now())

  // One explicit row per actual date. No recurrence rule by design: Indian
  // festival dates (Holi, Diwali) move every year against the Gregorian
  // calendar, and a wrong guess is worse than HR entering the real dates.
  @@index([date])
}

model ShoutOut {
  id             String   @id @default(cuid())
  fromEmployeeId String
  fromEmployee   Employee @relation("ShoutOutFrom", fields: [fromEmployeeId], references: [id])
  toEmployeeId   String
  toEmployee     Employee @relation("ShoutOutTo", fields: [toEmployeeId], references: [id])
  message        String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model PulseSurvey {
  id        String    @id @default(cuid())
  question  String
  scaleMin  Int       @default(1)
  scaleMax  Int       @default(5)
  createdBy String
  active    Boolean   @default(true)
  closesAt  DateTime?
  createdAt DateTime  @default(now())

  responses       PulseSurveyResponse[]
  responseRecords SurveyResponseRecord[]
}

// THE ANSWER. Deliberately has NO employeeId and no relation to any employee
// or to SurveyResponseRecord. There is no foreign key, no shared column and no
// timestamp precise enough to correlate — so no query, however written, can
// attribute a rating to a person. Anonymity here is structural, not a policy
// someone has to remember to honour.
model PulseSurveyResponse {
  id          String      @id @default(cuid())
  surveyId    String
  survey      PulseSurvey @relation(fields: [surveyId], references: [id])
  ratingValue Int
  createdAt   DateTime    @default(now())

  @@index([surveyId])
}

// THE TURNSTILE. Records only THAT someone responded, never WHAT they said.
// Its sole purpose is the unique constraint below, which blocks a second vote.
// It is never joined to PulseSurveyResponse anywhere in the codebase.
model SurveyResponseRecord {
  id         String      @id @default(cuid())
  surveyId   String
  survey     PulseSurvey @relation(fields: [surveyId], references: [id])
  employeeId String
  createdAt  DateTime    @default(now())

  @@unique([surveyId, employeeId])
}
