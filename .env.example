# ─────────────────────────────────────────────────────────────
# SESS — Environment variables
# Copy this file to `.env` and fill in real values.
# Both Clerk and Supabase should be NEW projects, not shared.
# ─────────────────────────────────────────────────────────────

# Clerk (create a new application at https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Clerk redirect overrides (defaults work for this project)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk webhook signing secret — REQUIRED for the invitation→account-link flow.
# In the Clerk dashboard: Webhooks → Add Endpoint →
#   URL:    <your-deployment-origin>/api/webhooks/clerk
#   Events: user.created
# Clerk generates this secret (whsec_...) when you create the endpoint.
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# Public base URL — OPTIONAL
# ─────────────────────────────────────────────────────────────
#
# Highest-priority override in appBaseUrl() (lib/app-url.ts), which builds the
# absolute links that LEAVE the app — today, the Clerk invitation accept link.
#
# Leave it UNSET on Vercel. The resolution order is:
#   1. NEXT_PUBLIC_APP_URL           this variable, if set
#   2. VERCEL_PROJECT_PRODUCTION_URL Vercel injects it; the stable production
#                                    domain, and the right answer by default
#   3. VERCEL_URL                    per-deployment fallback
#   4. http://localhost:3005         local development
#
# Set it only to FORCE a specific base URL instead of Vercel's automatic pick:
# a second custom domain, a staging host, or a non-Vercel deployment. The
# scheme is optional (https:// is assumed) and a trailing slash is stripped.
NEXT_PUBLIC_APP_URL=

# Supabase PostgreSQL (create a new project at https://supabase.com)
# Copy from Project Settings → Database → Connection string.
#
# Do NOT use the direct host (db.[PROJECT-REF].supabase.co). Supabase dropped
# IPv4 on direct connections, so on an IPv4-only network every query sits out a
# ~5s connect timeout and then fails. Use a Supavisor pooler host instead:
# aws-[N]-[REGION].pooler.supabase.com, username postgres.[PROJECT-REF].
#
# WHICH PORT DEPENDS ON WHERE THE CODE RUNS — this is the important part.
#
#   LOCAL DEV → SESSION mode, port 5432.
#     One long-lived dev server. Session mode pins one backend connection per
#     client for the whole session, so the client ceiling collapses to the
#     project's Pool Size (15 by default). connection_limit is therefore
#     MANDATORY: Prisma otherwise sizes its pool at num_cpus*2+1 (33 on a
#     16-core machine) and one dev server eats the entire project budget.
#     Session mode also keeps full session semantics, which `prisma migrate`
#     needs for its advisory lock — so migrations run against this URL.
#
#   VERCEL / any serverless → TRANSACTION mode, port 6543, ?pgbouncer=true.
#     Each function instance is its own short-lived Prisma client. In
#     transaction mode a backend connection is borrowed only for the duration
#     of a transaction and released on commit, so ~200 concurrent clients share
#     the same 15 backend connections instead of being capped at 15 total.
#     pgbouncer=true disables named prepared statements, which transaction mode
#     does not support. connection_limit=1 because a serverless invocation
#     serves one request and never needs a pool of its own.
#     Verified against this codebase: interactive `$transaction(async tx => …)`
#     (47 call sites) and `SELECT … FOR UPDATE` (lib/appraisal/cycle-lock.ts)
#     both work correctly in transaction mode — the pooler holds one backend
#     connection for the whole transaction. There is no session-level state
#     anywhere in this app (no advisory locks, LISTEN/NOTIFY, SET SESSION or
#     temp tables), which is what would actually have ruled transaction mode out.
#
# Local dev (also used for `prisma migrate`):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:5432/postgres?connection_limit=5"
# Vercel (set in the Vercel dashboard, NOT in this file):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─────────────────────────────────────────────────────────────
# Attendance punch validation (Phase 1)
# NOTE: the values below are PLACEHOLDERS — set real ones before relying
# on validation. Until then, keep ATTENDANCE_VALIDATION_MODE=NONE so punches
# are recorded without IP/geofence checks.
# ─────────────────────────────────────────────────────────────

# One of: NONE | IP_LOCK | GEOFENCE | BOTH
# ⚠️ PLACEHOLDER — decide the real mode for your deployment.
ATTENDANCE_VALIDATION_MODE=NONE

# Comma-separated allowlist of office egress IPs (used by IP_LOCK / BOTH).
# ⚠️ PLACEHOLDER — replace with your real office IP(s).
ALLOWED_IPS=

# Office coordinates + radius for the geofence (used by GEOFENCE / BOTH).
# ⚠️ PLACEHOLDER — replace with your real office lat/long.
OFFICE_LAT=
OFFICE_LONG=
# ⚠️ PLACEHOLDER — pick a real radius in metres (e.g. 100–250).
GEOFENCE_RADIUS_METERS=

# Workday start time "HH:MM" (24h, server local time). A check-in after this
# is flagged late. ⚠️ PLACEHOLDER — set your real start time.
# NOTE: this is only a FALLBACK. Lateness is normally measured against the
# employee's assigned Shift (startTime + gracePeriodMinutes); this env var is
# used only for an employee who somehow has no shift assigned.
WORKDAY_START=

# ─────────────────────────────────────────────────────────────
# Idle-time tracking (Phase 10)
# ─────────────────────────────────────────────────────────────

# Seconds of no input before the desktop agent counts a minute as idle.
# This is the DEPLOY-TIME DEFAULT only: a Super Admin can override it at
# runtime from Admin → Module Toggles, and the database value wins.
# Resolution order: SystemSetting row → this env var → 210.
# Accepted range 60–3600; anything outside it (or unset) falls back to 210.
IDLE_THRESHOLD_SECONDS=210

# ─────────────────────────────────────────────────────────────
# Demo mode — impersonation master switch
# ─────────────────────────────────────────────────────────────

# Set to 'true' only in a separate, disconnected demo deployment with its own
# database. Must remain unset/false in production.
#
# When unset or anything other than the exact string "true", the entire
# impersonation feature is inert: the Super Admin dashboard panel does not
# render, the start-impersonation server action rejects every caller including
# a genuine Super Admin, no impersonation token can be signed, and no existing
# cookie can be verified into an impersonated identity. Effective identity is
# then always the real identity.
DEMO_MODE=
