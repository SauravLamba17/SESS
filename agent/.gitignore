# The agent is its own npm package — its dependencies (Electron, ~200MB) must
# never be committed. The root .gitignore's /node_modules is anchored to the
# repo root and does NOT cover this directory.
node_modules/

# The agent's runtime config contains the REAL AgentToken — a credential.
# It normally lives in the OS app-data dir (outside this repo), but if anyone
# ever runs the agent with a local config for testing, it must not be staged.
config.json

# Build output from electron-builder.
dist/
out/

# THE CODE-SIGNING KEY. certs/sess-agent-signing.pfx and its password file are
# what let this machine sign software as Simplen — committing them would hand
# that ability to anyone with repo access. Regenerate with `npm run make-cert`;
# the public .cer that IT distributes lives here too and is derived from them.
certs/

# Generated previews from tools/make-icons.js debugging.
assets/_preview-*.png
